# Database: Turso (libSQL). turso db show <db> --url  /  turso db tokens create <db>
# (file:local.db works for a local SQLite file, without a token)
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=8

# Encrypts stored secrets such as SMTP passwords and app secrets (min 32 chars). Leave empty to
# derive it from JWT_SECRET — but then changing JWT_SECRET makes stored secrets unreadable.
# Set it once, before any secret is stored; changing it later has the same effect.
APP_ENCRYPTION_KEY=

# Default super admin, created only when the users table is empty
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# Temporary password for the demo accounts from the first-run seed (changed on first sign in)
DEMO_USER_PASSWORD=Demo@1234

# Swagger UI at /api/docs is always on in development; set true to enable it in production
API_DOCS=false

# Public URL / Host of the portal (e.g. https://pay4.lakshan.dev) — used for Stripe checkout redirects
# If empty, falls back to request headers (x-forwarded-host) or the incoming request origin.
APP_URL=

# Every setting below may be left empty: that feature is off until it's filled in.

# Stripe — one account for every platform. Without the secret key orders get no payment links.
# Secret key: Stripe Dashboard → Developers → API keys (sk_test_… / sk_live_…, or a restricted rk_…)
STRIPE_SECRET_KEY=
# Webhook: Stripe Dashboard → Developers → Webhooks → add endpoint https://<your-domain>/api/stripe/webhook
# with the events checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid,
# invoice.payment_failed, customer.subscription.deleted, charge.refunded — then paste its signing secret.
# Locally: stripe listen --forward-to localhost:3000/api/stripe/webhook (prints a whsec_ to use here)
STRIPE_WEBHOOK_SECRET=
# Payment methods shown on the payment page: turn them on in Stripe Dashboard → Settings → Payment methods.
# Expiry: call GET /api/health from a cron job (e.g. every 5 minutes) to mark overdue orders expired.

# Google Play Billing — one Google Cloud service account for every platform (see Webhooks →
# Google Play webhook → Setup). Without it apps can't report Google Play purchases.
# The service account's JSON key, as is or base64:
GOOGLE_PLAY_SERVICE_ACCOUNT=
# Real-time developer notifications: the Pub/Sub push subscription's Audience and the service
# account it signs pushes as. Google Play webhook URL: https://<your-domain>/api/google-play/webhook
GOOGLE_PLAY_PUSH_AUDIENCE=
GOOGLE_PLAY_PUSH_EMAIL=
